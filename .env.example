# Supabase (public — safe for browser / Render env)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Production URL (Render: https://ledscreem.onrender.com veya custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only secrets (NEVER expose to the browser / NEXT_PUBLIC_*)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Render Dashboard ---
# Service → Environment'a ekle (build öncesi zorunlu):
#   NEXT_PUBLIC_SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY
#   NEXT_PUBLIC_APP_URL=https://YOUR-SERVICE.onrender.com
# Supabase Auth → URL Configuration:
#   Site URL = NEXT_PUBLIC_APP_URL
#   Redirect URLs += https://YOUR-SERVICE.onrender.com/**
